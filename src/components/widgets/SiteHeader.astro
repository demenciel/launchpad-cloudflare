---
import Brand from '~/components/common/Brand.astro';
import ThemeToggle from '~/components/common/ThemeToggle.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
---
<header class="site-header">
  <div class="header-inner">
    <Brand />
    <nav class="header-nav" aria-label="Main navigation"><a href="/#features">Features</a><a href="/#how-it-works">How it works</a><a href="/#faq">FAQs</a></nav>
    <div class="header-actions">
      <ThemeToggle />
      <a class="header-login" href="/login">Log in</a>
      <Button variant="primary" text="Get started" href="/login" icon="tabler:arrow-up-right" class="py-2.5 px-4" />
      <details class="mobile-menu"><summary aria-label="Open navigation"><Icon name="tabler:menu-2" class="w-5 h-5" /></summary><nav aria-label="Mobile navigation"><a href="/#features">Features</a><a href="/#how-it-works">How it works</a><a href="/#faq">FAQs</a><a href="/login">Log in</a></nav></details>
    </div>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
    menu.addEventListener('keydown', (event) => { if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); } });
  });
</script>
