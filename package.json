{
  "name": "cloudflare-ai-saas-starter",
  "description": "AstroWind frontend and React workspace with Hono, Cloudflare D1, OAuth, Resend, OpenAI, and Motion",
  "version": "0.0.0",
  "cloudflare": {
    "label": "AstroWind Cloudflare SaaS Starter",
    "products": [
      "Workers",
      "D1"
    ],
    "publish": false
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-validator": "^0.7.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-form": "^1.12.1",
    "@tanstack/react-query": "^5.80.2",
    "@tanstack/react-router": "^1.120.15",
    "@tanstack/react-router-devtools": "^1.120.15",
    "ai": "^4.3.16",
    "astro": "7.3.1",
    "astro-icon": "^1.2.0",
    "better-auth": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.1",
    "drizzle-zod": "^0.8.2",
    "hono": "4.7.7",
    "lucide-react": "^0.511.0",
    "motion": "^14.0.0",
    "next-themes": "^0.4.6",
    "openai": "^7.31.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.32.1",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "workers-ai-provider": "^0.6.1",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "1.9.4",
    "@iconify-json/tabler": "^1.2.42",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/router-plugin": "^1.120.15",
    "@types/node": "^22.15.30",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.31.1",
    "globals": "15.15.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.3.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "wrangler": "4.36.0"
  },
  "scripts": {
    "build": "astro build && tsc -b",
    "cf-typegen": "wrangler types",
    "check": "bun run typecheck && bun run test && bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy",
    "dev": "node scripts/dev.mjs",
    "lint": "biome lint src/client src/worker src/shared tests",
    "preview": "wrangler dev",
    "db:generate": "bun drizzle-kit generate",
    "db:studio": "bun drizzle-kit studio",
    "db:migrate": "bunx wrangler d1 migrations apply cloudflare-ai-saas-stack --local",
    "db:migrate:remote": "bunx wrangler d1 migrations apply cloudflare-ai-saas-stack --remote",
    "test": "bun test",
    "typecheck": "astro check --tsconfig tsconfig.astro.json && tsc -b"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  }
}
